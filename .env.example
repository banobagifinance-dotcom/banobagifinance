# Supabase (ใช้สำหรับล็อกอิน + เก็บรูปภาพเท่านั้น)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Google Sheets (ใช้เป็น database ของรายการสินทรัพย์)
# 1. ไปที่ Google Cloud Console สร้างโปรเจกต์ > APIs & Services > Credentials > Create Service Account
# 2. สร้าง key (JSON) แล้ว copy ทั้งก้อนมาใส่ GOOGLE_SERVICE_ACCOUNT_JSON (ใส่เป็น string เดียว ไม่มี line break)
# 3. สร้าง Google Sheet ใหม่ แล้วแชร์ให้อีเมลของ Service Account (client_email ใน JSON) เป็น Editor
# 4. คัดลอก Sheet ID จาก URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
# 5. ใน Sheet ให้มีชีตชื่อ "Assets" (หรือเปลี่ยนชื่อ Sheet1 เป็น Assets)
GOOGLE_SPREADSHEET_ID=

# วิธีใดวิธีหนึ่ง: ใส่ JSON string ทั้งก้อน หรือใส่ path ไปที่ไฟล์ JSON
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
